# Paseos: perfil a pie "con vida". Prefiere calles con gente: avenidas con vereda, paseos peatonales y calles
# principales, donde uno camina acompañado. Evita senderos aislados, callejones y pasajes de servicio.
# El comercio no lo sabe BRouter: la app lo suma después con datos de OpenStreetMap.
# Costo 1 = calle ideal. Mientras más alto el costo, más la evita BRouter.

---context:global

assign validForFoot          1
assign turnInstructionMode   1
assign processUnusedTags     false

assign evitar_subidas  = false
assign downhillcost    0
assign downhillcutoff  1.5
assign uphillcost      if evitar_subidas then 60 else 0
assign uphillcutoff    1.5

---context:way

assign defaultaccess  switch access=  not motorroad=yes  switch or access=private access=no  0  1

assign bikeaccess
       switch bicycle=
              switch vehicle=
                     defaultaccess
                     switch or vehicle=private vehicle=no  0  1
              not or bicycle=private or bicycle=no bicycle=dismount

assign issidewalk  sidewalk=left|right|both|yes

assign footaccess  or issidewalk
                   or and bikeaccess  not foot=no|use_sidepath
                   or bicycle=dismount
                   switch foot=  defaultaccess  not foot=private|no|use_sidepath

assign accesspenalty  switch footaccess 0  switch foot=use_sidepath 10  100000

assign turncost     0
assign initialcost  switch route=ferry 10000 0

assign esvereda  and highway=footway footway=sidewalk

# Muy silencioso suele ser vacío; el ruido extremo (autopista al lado) tampoco es agradable.
assign noise_penalty
       switch estimated_noise_class=   0.1
       switch estimated_noise_class=1  0.4
       switch estimated_noise_class=2  0.2
       switch estimated_noise_class=6  0.5  0

assign lit_penalty  switch lit=yes 0  switch lit=no 0.3  0.05

assign basecost
       if      ( and highway= not route=ferry )                  then 100000
       else if highway=motorway|motorway_link                    then 100000
       else if highway=proposed|abandoned|construction           then 100000
       else if route=ferry                                       then 100000
       else if esvereda                                          then 1.0
       else if highway=pedestrian                                then 1.0
       else if highway=tertiary|tertiary_link                    then ( switch issidewalk 1.0 1.3 )
       else if highway=secondary|secondary_link                  then ( switch issidewalk 1.0 1.4 )
       else if highway=primary|primary_link                      then ( switch issidewalk 1.1 1.6 )
       else if highway=living_street                             then 1.15
       else if highway=residential                               then 1.25
       else if highway=unclassified                              then 1.3
       else if highway=footway                                   then 1.4
       else if highway=cycleway                                  then 1.5
       else if highway=steps                                     then 1.6
       else if highway=service                                   then 1.8
       else if highway=path|track|bridleway                      then 2.0
       else if highway=trunk|trunk_link                          then ( switch issidewalk 3.0 8.0 )
       else 2.0

assign costfactor  add accesspenalty  add noise_penalty  add lit_penalty  basecost

---context:node

assign initialcost 0
