# Paseos: perfil a pie que prefiere calles tranquilas.
# Costo 1 = calle ideal. Mientras más alto el costo, más la evita BRouter.
# Basado en la lógica de acceso de hiking-mountain.brf (BRouter).

---context:global

assign validForFoot          1
assign turnInstructionMode   1
assign processUnusedTags     false

# Sin costo por subidas: en paseos urbanos importa más el tipo de calle.
assign downhillcost    0
assign downhillcutoff  1.5
assign uphillcost      0
assign uphillcutoff    1.5

---context:way

assign defaultaccess  switch access=  not motorroad=yes  switch or access=private access=no  0  1

assign bikeaccess
       switch bicycle=
              switch vehicle=
                     defaultaccess
                     switch or vehicle=private vehicle=no  0  1
              not or bicycle=private or bicycle=no bicycle=dismount

assign issidewalk  sidewalk=left|right|both|yes

assign footaccess  or issidewalk
                   or and bikeaccess  not foot=no|use_sidepath
                   or bicycle=dismount
                   switch foot=  defaultaccess  not foot=private|no|use_sidepath

assign accesspenalty  switch footaccess 0  switch foot=use_sidepath 10  100000

assign turncost     0
assign initialcost  switch route=ferry 10000 0

# Ruido estimado por BRouter (1 = silencioso, 6 = muy ruidoso).
assign noise_penalty
       switch estimated_noise_class=   0
       switch estimated_noise_class=1  0.1
       switch estimated_noise_class=2  0.3
       switch estimated_noise_class=3  0.6
       switch estimated_noise_class=4  1.2
       switch estimated_noise_class=5  2.0
       switch estimated_noise_class=6  3.0  0

# Áreas verdes cerca (1 = poco verde, 6 = muy verde). Lo verde baja el costo.
assign green_penalty
       switch estimated_forest_class=   0.3
       switch estimated_forest_class=1  0.25
       switch estimated_forest_class=2  0.2
       switch estimated_forest_class=3  0.1
       switch estimated_forest_class=4  0.05
       switch estimated_forest_class=5  0.0
       switch estimated_forest_class=6  0.0  0

assign basecost
       if      ( and highway= not route=ferry )                  then 100000
       else if highway=motorway|motorway_link                    then 100000
       else if highway=proposed|abandoned|construction           then 100000
       else if route=ferry                                       then 100000
       else if highway=footway|path|living_street                then 1.0
       else if highway=pedestrian                                then 1.2
       else if highway=steps                                     then 1.4
       else if highway=track|bridleway                           then 1.2
       else if highway=cycleway                                  then 1.2
       else if highway=residential                               then 1.1
       else if highway=service                                   then 1.25
       else if highway=unclassified                              then 1.4
       else if highway=tertiary|tertiary_link                    then ( switch issidewalk 1.8 2.5 )
       else if highway=secondary|secondary_link                  then ( switch issidewalk 2.6 4.0 )
       else if highway=primary|primary_link                      then ( switch issidewalk 3.5 6.0 )
       else if highway=trunk|trunk_link                          then ( switch issidewalk 6.0 15.0 )
       else 2.0

assign costfactor  add accesspenalty  add noise_penalty  add green_penalty  basecost

---context:node

assign initialcost 0
